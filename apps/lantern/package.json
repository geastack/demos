{
  "name": "@geastack/demo-lantern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "icons": "node ../../shared/scripts/build-icons.mjs"
  },
  "dependencies": {
    "@demos/shared": "*",
    "@geastack/core": "^0.1.41",
    "@geastack/gea3d": "^0.1.2"
  },
  "gea": {
    "id": "lantern",
    "name": "Lantern River",
    "entry": "src/index.tsx",
    "targets": {
      "web": true,
      "tvos": true,
      "esp32": {
        "display": {
          "copyBack": "dma",
          "bounceRows": 10,
          "gridStrips": true
        },
        "boards": {
          "esp32-s3-elecrow-crowpanel-advance-7.0": {
            "psram": {
              "speed": 120
            },
            "flashFreq": 40
          },
          "esp32-p4-elecrow-crowpanel-advanced-5.0": {
            "defines": {
              "GEA_EMBEDDED_RGB_KEEP_VSYNC": 1,
              "GEA_EMBEDDED_DISPLAY_REPLAY_SRAM_STAGE": 1
            }
          }
        }
      },
      "stm32": true
    },
    "cssDevicePixelRatio": 1,
    "nativeSources": [
      "@geastack/gea3d/native/gea3d_native.cpp"
    ]
  },
  "license": "GPL-3.0-only"
}
