CONFIG_LWIP_IPV6=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=23040
CONFIG_LWIP_L2_TO_L3_COPY=y
# The UI and session worker use CPU1; Wi-Fi stays with native audio capture.
# CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0 is not set
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
# CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1 is not set
# Camera and full-duplex audio occupy Mosaico's GDMA channels. TLS must
# not require another channel while these peripherals are running.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=2000
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_DHCPS=y
# Mosaico's media-enabled firmware overflows IDLE1 during startup at IDF's
# 1536-byte default, before the USB console can become available.
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
